{
  "id": "tower",
  "name": "OpenATC Tower game",
  "about": "Phraseology for the tower game: what pilots say ('pilot'), how they read back ('readback'), what the command buttons say for you ('controller') and the patterns that recognise your spoken or typed commands ('commands', regular expressions tried top to bottom on lower-case text with numbers as digits). {placeholders} are filled in; [parts] disappear when a placeholder inside is empty. Copy to userdata/phraseology/tower.json to keep your changes.",

  "pilot": {
    "arr_checkin": ["{unit}, {callsign}, {approach} runway {runway}, {distance}.", "{unit}, good day, {callsign}, established {approach} runway {runway}, {distance}.", "{unit}, {callsign}, with you on the {approach} runway {runway}, {distance} out.", "{unit}, hello, {callsign}, {approach} runway {runway}, {distance}."],
    "arr_short_final": ["{unit}, {callsign}, short final runway {runway}.", "{callsign}, short final runway {runway}.", "{unit}, {callsign}, on short final {runway}."],
    "go_around": ["{callsign}, going around.", "Going around, {callsign}.", "{callsign}, go-around."],
    "vacated": ["{unit}, {callsign}, runway {runway} vacated, request taxi to stand {gate}.", "{unit}, {callsign}, vacated runway {runway}, for stand {gate}.", "{unit}, {callsign}, clear of runway {runway}, request taxi stand {gate}."],
    "push": ["{unit}, {callsign}, stand {gate}, request pushback.", "{unit}, {callsign}, stand {gate}, ready for pushback.", "{unit}, good day, {callsign} on stand {gate}, request push and start.", "{unit}, {callsign}, stand {gate}, request pushback and start up."],
    "taxi": ["{unit}, {callsign}, ready to taxi.", "{unit}, {callsign}, request taxi.", "{unit}, {callsign}, pushback complete, ready to taxi."],
    "ready": ["{unit}, {callsign}, holding point runway {runway}, ready for departure.", "{unit}, {callsign}, ready for departure runway {runway}.", "{unit}, {callsign}, holding point runway {runway}, fully ready."],
    "hold_short": ["{unit}, {callsign}, holding short runway {runway}.", "{unit}, {callsign}, holding short of runway {runway}."],
    "handoff": ["{unit}, {callsign}, request frequency change.", "{callsign}, request to change to departure."],
    "blocked": ["{unit}, {callsign}, we're blocked by traffic, request instructions.", "{unit}, {callsign}, we are stuck behind traffic, request instructions."]
  },

  "readback": {
    "land": ["Cleared to land runway {runway}, {callsign}.", "Runway {runway}, cleared to land, {callsign}.", "Cleared to land {runway}, {callsign}."],
    "continue": ["Continue approach, {callsign}.", "Continuing, {callsign}."],
    "go_around": ["Going around, {callsign}.", "Going around, {callsign}, wilco."],
    "push": ["Pushback approved, {callsign}.", "Pushing back, {callsign}.", "Push approved, {callsign}."],
    "taxi_out": "Taxi to holding point runway {runway}[ via {via}][, cross runway {cross}], {callsign}.",
    "taxi_in": "Taxi to stand {gate}[ via {via}][, cross runway {cross}], {callsign}.",
    "hold_position": ["Holding position, {callsign}.", "Holding, {callsign}.", "Holding position, wilco, {callsign}."],
    "continue_taxi": ["Continue taxi, {callsign}.", "Continuing taxi, {callsign}."],
    "hold_short": "Hold short runway {runway}, {callsign}.",
    "cross": "Cross runway {runway}, {callsign}.",
    "lineup": ["Line up and wait runway {runway}, {callsign}.", "Lining up runway {runway}, {callsign}.", "Line up and wait {runway}, {callsign}."],
    "takeoff": ["Cleared for take-off runway {runway}, {callsign}.", "Cleared for take-off {runway}, {callsign}.", "Runway {runway}, cleared for take-off, {callsign}."],
    "contact": ["Contact departure, good day, {callsign}.", "Over to departure, good day, {callsign}.", "Departure, {callsign}, thanks for your help.", "Contact departure, {callsign}, bye bye."],
    "unable": "Unable, {reason}, {callsign}.",
    "say_again": ["Say again for {callsign}?", "{callsign}, say again?", "Sorry, say again for {callsign}?"]
  },

  "controller": {
    "land": "{callsign}, [wind {wind}, ]runway {runway}, cleared to land.",
    "continue": "{callsign}, continue approach.",
    "go_around": "{callsign}, go around.",
    "push": "{callsign}, pushback approved.",
    "taxi_out": "{callsign}, taxi to holding point runway {runway}[ via {via}][, cross runway {cross}].",
    "taxi_in": "{callsign}, taxi to stand {gate}[ via {via}][, cross runway {cross}].",
    "hold_position": "{callsign}, hold position.",
    "continue_taxi": "{callsign}, continue taxi.",
    "cross": "{callsign}, cross runway {runway}.",
    "hold_short": "{callsign}, hold short runway {runway}.",
    "lineup": "{callsign}, runway {runway}, line up and wait.",
    "takeoff": "{callsign}, [wind {wind}, ]runway {runway}, cleared for take-off.",
    "contact": "{callsign}, contact departure, good day."
  },

  "buttons": {
    "land": "Cleared to land",
    "continue": "Continue approach",
    "go_around": "Go around",
    "push": "Pushback approved",
    "taxi_out": "Taxi to runway",
    "taxi_in": "Taxi to stand",
    "hold_position": "Hold position",
    "continue_taxi": "Continue taxi",
    "cross": "Cross runway",
    "hold_short": "Hold short",
    "lineup": "Line up and wait",
    "takeoff": "Cleared for take-off",
    "contact": "Contact departure"
  },

  "commands": [
    { "cmd": "go_around", "patterns": ["go ?around", "missed approach"] },
    { "cmd": "land", "patterns": ["clear\\w* to land", "clear\\w* land", "cleared for (the )?landing"] },
    { "cmd": "takeoff", "patterns": ["clear\\w* for (immediate )?take ?off", "clear\\w* take ?off", "clear\\w* for departure"] },
    { "cmd": "lineup", "patterns": ["line ?up"] },
    { "cmd": "cross", "patterns": ["^(?!.*taxi).*cross"] },
    { "cmd": "hold_short", "patterns": ["^(?!.*taxi).*hold(ing)? short"] },
    { "cmd": "hold_position", "patterns": ["hold (your )?position", "^(?!.*taxi).*\\bstop\\b", "^(?!.*(taxi|short)).*\\bhold\\b"] },
    { "cmd": "continue_taxi", "patterns": ["continue (taxi|taxiing)", "resume taxi"] },
    { "cmd": "continue", "patterns": ["continue approach", "^(?!.*taxi).*\\bcontinue\\b"] },
    { "cmd": "push", "patterns": ["push ?back", "\\bpush\\b"] },
    { "cmd": "taxi", "patterns": ["\\btaxi\\b"] },
    { "cmd": "contact", "patterns": ["contact (departure|radar|approach|center|centre|control)", "frequency change approved", "good ?day", "monitor"] }
  ]
}
